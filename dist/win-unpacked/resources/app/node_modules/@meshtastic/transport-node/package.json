{
  "name": "@meshtastic/transport-node",
  "version": "0.0.2",
  "description": "NodeJS-specific transport layer for Meshtastic web applications.",
  "exports": {
    ".": "./dist/mod.js"
  },
  "type": "module",
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "main": "./dist/mod.js",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "license": "GPL-3.0-only",
  "tsdown": {
    "entry": "mod.ts",
    "dts": true,
    "format": [
      "esm"
    ],
    "splitting": false,
    "clean": true
  },
  "jsrInclude": [
    "mod.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "jsrExclude": [
    "src/**/*.test.ts"
  ],
  "dependencies": {
    "@meshtastic/core": "2.6.7"
  }
}